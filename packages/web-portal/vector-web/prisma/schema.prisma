generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Table 1: users
model users {
  id                     String                   @id @default(uuid()) @db.Uuid
  student_id             String?                  @unique
  full_name              String?
  role                   String?                  // 'student', 'registrar', 'verifier'
  wallet_address         String                   @unique
  avatar_url             String?
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  
  // Relations
  verified_credentials   verified_credentials[]
  minting_batches        minting_batches[]
  self_reported_skills   self_reported_skills[]
  enrollments            student_course_enrollments[]
}

// Table 2: minting_batches
model minting_batches {
  id               String                 @id @default(uuid()) @db.Uuid
  registrar_id     String?                @db.Uuid
  batch_name       String?
  total_students   Int?
  created_at       DateTime?              @default(now()) @db.Timestamptz(6)
  
  // Relations
  registrar        users?                 @relation(fields: [registrar_id], references: [id])
  credentials      verified_credentials[]
}

// Table 3: verified_credentials (Blockchain Mirror)
model verified_credentials {
  id               String           @id @default(uuid()) @db.Uuid
  user_id          String           @db.Uuid
  batch_id         String?          @db.Uuid
  skill_name       String
  token_id         String
  transaction_hash String?
  issuer_did       String?
  metadata_uri     String?
  issued_at        DateTime?        @default(now()) @db.Timestamptz(6)

  // Relations
  student          users            @relation(fields: [user_id], references: [id])
  batch            minting_batches? @relation(fields: [batch_id], references: [id])
}

// Table 4: self_reported_skills
model self_reported_skills {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  skill_name     String
  proficiency    String?   // 'Beginner', 'Intermediate', 'Expert'
  evidence_link  String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  // Relations
  student        users     @relation(fields: [user_id], references: [id])
}

// Table 5: market_snapshots
model market_snapshots {
  id           BigInt    @id @default(autoincrement())
  skill_name   String
  job_count    Int
  data_source  String?   @default("jsearch")
  recorded_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([skill_name, recorded_at(sort: Desc)])
}

// Table 6: skill_health_cache
model skill_health_cache {
  skill_name   String    @id
  trend_slope  Float?
  status       String?   // 'Rising', 'Stable', 'Decaying'
  last_updated DateTime? @default(now()) @db.Timestamptz(6)
}

// Table 7: courses
model courses {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  provider    String?
  skill_tags  String[]
  link        String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  enrollments student_course_enrollments[]
}

// Table 8: student_course_enrollments
model student_course_enrollments {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  course_id    String    @db.Uuid
  status       String?   // 'completed', 'in_progress'
  completed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  // Relations
  student      users     @relation(fields: [user_id], references: [id])
  course       courses   @relation(fields: [course_id], references: [id])
}